NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://spotway:spotway@localhost:5432/spotway?schema=public"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
FRONTEND_OAUTH_CALLBACK_URL=http://localhost:5173/auth/callback
MAP_UNITS_PER_METER=1
ROUTE_WALKING_SPEED_MPS=1.2
ELEVATOR_TRANSITION_WEIGHT=20
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=
MONGODB_DB=spotway_analytics
MONGODB_EVENTS_TTL_DAYS=90
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=100
